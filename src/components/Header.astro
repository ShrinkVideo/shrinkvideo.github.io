---
import { languages, type Locale, useTranslations, getLocalePath } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const currentLangObj = languages[lang];
---

<header class="w-full sticky top-0 z-50 backdrop-blur-md bg-[var(--bg-surface-card)]/90 border-b border-[var(--border-color)]/35 transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 h-16 md:h-18 flex items-center justify-between gap-2">
    
    <!-- Brand Logo + Title (Desktop shows text, Mobile <768px shows 48x48px icon only) -->
    <a
      href={getLocalePath(lang)}
      aria-label={t('nav.brand')}
      class="flex items-center gap-3 min-w-[48px] min-h-[48px] justify-center md:justify-start rounded-xl px-1.5 md:px-2 hover:opacity-90 transition-opacity focus:outline-none focus:ring-2 focus:ring-[#9290C3]"
    >
      <div class="w-11 h-11 rounded-xl bg-[#1B1A55] border border-[#9290C3]/50 flex items-center justify-center shadow-sm shrink-0">
        <svg class="w-7 h-7 text-[#F5F5FA]" viewBox="0 0 128 128" fill="none" aria-hidden="true">
          <path d="M50 40L88 64L50 88V40Z" fill="#F5F5FA"/>
          <path d="M20 36L38 50L20 64" stroke="#9290C3" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M108 36L90 50L108 64" stroke="#9290C3" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M20 68L38 82L20 96" stroke="#535C91" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M108 68L90 82L108 96" stroke="#535C91" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <span class="hidden md:inline-block font-extrabold text-xl tracking-tight text-[var(--text-primary)]">
        {t('nav.brand')}
      </span>
    </a>

    <!-- Right Controls -->
    <nav class="flex items-center gap-1.5 sm:gap-2.5" aria-label="Main Navigation">
      
      <!-- 8-Language Dropdown Selector -->
      <div class="relative" id="lang-dropdown-wrapper">
        <button
          type="button"
          id="lang-dropdown-btn"
          aria-label={t('nav.language')}
          aria-expanded="false"
          aria-haspopup="true"
          class="min-w-[48px] min-h-[48px] md:px-3.5 rounded-xl border border-[var(--border-color)]/50 bg-[var(--highlight-pill-badge)] text-[var(--text-primary)] hover:border-[#1B1A55] dark:hover:border-[#9290C3] flex items-center justify-center gap-2 transition-all cursor-pointer"
        >
          <!-- Globe SVG Icon -->
          <svg class="w-6 h-6 text-[var(--text-primary)] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
          </svg>
          <span class="hidden md:inline-block font-semibold text-sm">
            {currentLangObj.code} • {currentLangObj.name}
          </span>
          <svg class="hidden md:inline-block w-4 h-4 opacity-75" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div
          id="lang-dropdown-menu"
          role="menu"
          class="hidden absolute right-0 mt-2 w-48 rounded-2xl bg-[var(--bg-surface-card)] border border-[var(--border-color)] shadow-2xl py-2 z-50"
        >
          {Object.entries(languages).map(([code, info]) => (
            <a
              href={getLocalePath(code as Locale)}
              role="menuitem"
              class:list={[
                'flex items-center justify-between px-4 py-2.5 text-sm font-medium transition-colors',
                code === lang
                  ? 'bg-[#1B1A55] text-white font-bold'
                  : 'text-[var(--text-primary)] hover:bg-[var(--highlight-pill-badge)]'
              ]}
            >
              <span>{info.name}</span>
              <span class="text-xs uppercase opacity-75 font-bold">{info.code}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Light / Dark Mode Toggle Button -->
      <button
        type="button"
        id="theme-toggle-btn"
        aria-label={t('nav.theme')}
        title={t('nav.theme')}
        class="min-w-[48px] min-h-[48px] rounded-xl border border-[var(--border-color)]/50 bg-[var(--highlight-pill-badge)] text-[var(--text-primary)] hover:border-[#1B1A55] dark:hover:border-[#9290C3] flex items-center justify-center transition-all cursor-pointer"
      >
        <!-- Sun Icon (shown in dark mode) -->
        <svg id="theme-icon-sun" class="hidden w-6 h-6 text-[#F5F5FA]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
        </svg>
        <!-- Moon Icon (shown in light mode) -->
        <svg id="theme-icon-moon" class="w-6 h-6 text-[#1B1A55]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
        </svg>
      </button>

      <!-- Install PWA Button ('Add to Home Screen') -->
      <button
        type="button"
        id="install-pwa-btn"
        aria-label={t('nav.installPwa')}
        title={t('nav.installPwa')}
        class="min-w-[48px] min-h-[48px] md:px-3.5 rounded-xl border border-[var(--border-color)]/50 bg-[var(--highlight-pill-badge)] text-[var(--text-primary)] hover:border-[#1B1A55] dark:hover:border-[#9290C3] flex items-center justify-center gap-2 transition-all cursor-pointer"
      >
        <svg class="w-6 h-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
        </svg>
        <span class="hidden lg:inline-block font-semibold text-sm whitespace-nowrap">
          {t('nav.installPwa')}
        </span>
      </button>

      <!-- CTA Button: 'Support the Developer' -->
      <a
        href="https://kisharadilshan.gumroad.com/coffee"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t('nav.support')}
        title={t('nav.support')}
        class="min-w-[48px] min-h-[48px] md:px-4 rounded-xl bg-[#1B1A55] text-[#FFFFFF] border-2 border-[#535C91] hover:bg-[#070F2B] hover:shadow-[0_0_18px_rgba(83,92,145,0.75)] flex items-center justify-center gap-2 font-bold text-sm transition-all"
      >
        <svg class="w-6 h-6 text-[#9290C3] shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z" />
        </svg>
        <span class="hidden md:inline-block whitespace-nowrap">
          {t('nav.support')}
        </span>
      </a>

    </nav>
  </div>
</header>

<!-- PWA Install Toast Modal for browsers without native prompt -->
<div id="pwa-toast" class="hidden fixed bottom-5 right-5 z-50 max-w-sm rounded-2xl bg-[#1B1A55] text-white border border-[#9290C3] p-4 shadow-2xl">
  <div class="flex items-start justify-between gap-3">
    <p class="text-sm font-medium leading-relaxed" id="pwa-toast-text">
      Bookmark or use your browser menu ("Add to Home Screen" / "Install App") for 1-click offline access!
    </p>
    <button type="button" id="pwa-toast-close" aria-label="Close" class="text-[#9290C3] hover:text-white font-bold text-lg leading-none cursor-pointer">×</button>
  </div>
</div>

<script is:inline>
  (function () {
    // Language dropdown toggle
    const langBtn = document.getElementById('lang-dropdown-btn');
    const langMenu = document.getElementById('lang-dropdown-menu');
    const langWrapper = document.getElementById('lang-dropdown-wrapper');

    if (langBtn && langMenu) {
      langBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isHidden = langMenu.classList.contains('hidden');
        langMenu.classList.toggle('hidden', !isHidden);
        langBtn.setAttribute('aria-expanded', String(isHidden));
      });

      document.addEventListener('click', (e) => {
        if (langWrapper && !langWrapper.contains(e.target)) {
          langMenu.classList.add('hidden');
          langBtn.setAttribute('aria-expanded', 'false');
        }
      });
    }

    // Theme toggle logic
    const themeBtn = document.getElementById('theme-toggle-btn');
    const sunIcon = document.getElementById('theme-icon-sun');
    const moonIcon = document.getElementById('theme-icon-moon');

    function syncThemeIcons() {
      const isDark = document.documentElement.classList.contains('dark');
      if (sunIcon && moonIcon) {
        sunIcon.classList.toggle('hidden', !isDark);
        moonIcon.classList.toggle('hidden', isDark);
      }
    }

    syncThemeIcons();

    if (themeBtn) {
      themeBtn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('shrinkvideo-theme', isDark ? 'dark' : 'light');
        } catch (_) {}
        syncThemeIcons();
      });
    }

    // Install PWA button logic
    let deferredPrompt = null;
    const installBtn = document.getElementById('install-pwa-btn');
    const pwaToast = document.getElementById('pwa-toast');
    const pwaClose = document.getElementById('pwa-toast-close');

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
    });

    if (installBtn) {
      installBtn.addEventListener('click', async () => {
        if (deferredPrompt) {
          deferredPrompt.prompt();
          await deferredPrompt.userChoice;
          deferredPrompt = null;
        } else if (pwaToast) {
          pwaToast.classList.remove('hidden');
          setTimeout(() => pwaToast.classList.add('hidden'), 5000);
        }
      });
    }

    if (pwaClose && pwaToast) {
      pwaClose.addEventListener('click', () => pwaToast.classList.add('hidden'));
    }
  })();
</script>
